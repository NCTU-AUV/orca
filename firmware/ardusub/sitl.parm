# Orca 的 ArduSub SITL 參數。
# 值取自實機飛控（CUAV V5、ArduSub 4.7.2）2026-11-05 的參數快照，再套用 2026-11-06 的修改
# （JS_GAIN_DEFAULT 1.0、ATC_ANG_RLL_P 6、ATC_RAT_RLL_I 0、ATC_RAT_PIT_I 0）。
# 只收錄影響控制行為的參數。實體感測器的校正值、BATT_*、ARMING_SKIPCHK 不帶入。

# ---- 機架與馬達 ----
FRAME_CONFIG       2
MOT_1_DIRECTION   -1
MOT_2_DIRECTION    1
MOT_3_DIRECTION   -1
MOT_4_DIRECTION    1
MOT_5_DIRECTION    1
MOT_6_DIRECTION   -1
MOT_7_DIRECTION   -1
MOT_8_DIRECTION    1
MOT_PWM_MIN     1100
MOT_PWM_MAX     1900
MOT_THST_EXPO   0.65
MOT_THST_HOVER  0.5
MOT_SPIN_ARM    0.10
MOT_SPIN_MIN    0.15
MOT_SPIN_MAX    0.95

# ---- 搖桿（只在開機時讀）----
JS_GAIN_DEFAULT 1.0

# ---- 姿態 ----
ATC_ACC_P_MAX     1100
ATC_ACC_R_MAX     1100
ATC_ACC_Y_MAX     1100
ATC_ANGLE_BOOST   1
ATC_ANGLE_MAX     30
ATC_ANG_LIM_TC    1.0
ATC_ANG_PIT_P     6.0
ATC_ANG_RLL_P     6.0
ATC_ANG_YAW_P     6.0
ATC_INPUT_TC      0.1
ATC_RATE_FF_ENAB  1
ATC_RATE_P_MAX    0
ATC_RATE_R_MAX    0
ATC_RATE_WPY_MAX  60
ATC_RATE_Y_MAX    180
ATC_RAT_PIT_P     0.135
ATC_RAT_PIT_I     0
ATC_RAT_PIT_D     0.0036
ATC_RAT_PIT_IMAX  0.444
ATC_RAT_PIT_FLTD  30
ATC_RAT_PIT_FLTT  30
ATC_RAT_RLL_P     0.135
ATC_RAT_RLL_I     0
ATC_RAT_RLL_D     0.0036
ATC_RAT_RLL_IMAX  0.444
ATC_RAT_RLL_FLTD  30
ATC_RAT_RLL_FLTT  30
ATC_RAT_YAW_P     0.18
ATC_RAT_YAW_I     0.018
ATC_RAT_YAW_D     0
ATC_RAT_YAW_IMAX  0.222
ATC_RAT_YAW_FLTD  5
ATC_RAT_YAW_FLTT  5
ATC_THR_MIX_MAN   0.5
ATC_THR_MIX_MAX   0.5
ATC_THR_MIX_MIN   0.1
ACRO_YAW_P        4.5

# ---- 定深 ----
PSC_D_POS_P     3.0
PSC_D_VEL_P     8.0
PSC_D_VEL_I     0
PSC_D_VEL_IMAX  10
PSC_D_VEL_FLTD  5
PSC_D_VEL_FLTE  5
PSC_D_ACC_P     0.05
PSC_D_ACC_I     0.01
PSC_D_ACC_D     0
PSC_D_ACC_FF    0
PSC_D_ACC_IMAX  0.1
PSC_D_ACC_FLTE  20
PSC_D_JERK      50

# ---- Failsafe ----
FS_PILOT_INPUT    2
FS_PILOT_TIMEOUT  3
FS_GCS_ENABLE     2
FS_GCS_TIMEOUT    5

# ---- 地面站 ----
MAV_GCS_SYSID   255

# ---- SITL 模擬硬體（不是飛控參數）----
# 實機船上沒有 GPS（水下也收不到），關掉 SITL 模擬的 GPS，EKF 才與實機一樣沒有水平位置
SIM_GPS1_ENABLE 0
# ArduSub 的模擬深度計把 SITL 的海拔高度直接當成水深換算水壓，所以起始海拔必須 = 0（水面）。
# 預設的 584 m 會算出負的水壓，深度計失效，ALT_HOLD 定不住
SIM_OPOS_ALT    0
# 模擬深度計的雜訊（±m）。預設 0.2 m 是給空中載具的氣壓計，實機 Bar02 靜止時約 ±0.3 mm
SIM_BARO_RND    0.0003
SIM_BAR2_RND    0.0003
