<?xml version="1.0"?>
<!--
  Orca 載具：船體、浮力體、阻力、8 顆推進器。
  外觀與推進器位置取自 CAD「外殼重作版組合件.SLDASM」（ORCA AUV 5.0）：tools/cad/sldasm_mesh.py
  從組合件讀出網格（meshes/*.stl，零件座標）與各零件的姿態。CAD 沒有電子艙內容物，
  質量、慣量、浮力、阻力係數仍是 https://github.com/NCTU-AUV/SAUVC-Simulation 的 models/orca_auv 的估計值。

  座標：機體 FLU（x 前、y 左、z 上），原點 = CAD 整台外框的中心（長 0.500、寬 0.483、高 0.283 m），
  並假設質心就在這裡（還沒實測）。CAD 前後對稱，看不出哪一端是船頭，這裡取組合件的 +Z 為船頭、+Y 為上。
  浮力體（main_body_buoyancy）中心在質心上方 0.115 m，浮心高於重心，靜止時自動回正。
  推進器 0-3 垂直、4-7 水平（與 x 軸夾 45 度）；推力沿各自 joint 的 x 軸。位置 = CAD 裡 T200 零件的外框中心。
  推力：ArduPilotPlugin 送 PWM 到 /model/orca/joint/thruster_N_joint/cmd_pwm，orca::ThrustCurve 依 T200 推力表
  （t200_bollard.csv）換成推力，再送到 Thruster 外掛的 /model/orca/joint/thruster_N_joint/cmd_thrust（N）。
-->
<sdf version="1.9">
  <model name="orca">

    <link name="base_link">
      <inertial>
        <mass>20</mass>
        <inertia><ixx>0.2</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia>
      </inertial>

      <!-- 唯一的 collision，同時是 Buoyancy 計算排水體積的形狀：0.024 m^3 → 浮力約 235 N -->
      <collision name="main_body_buoyancy">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><box><size>0.6 0.2 0.2</size></box></geometry>
      </collision>

      <!-- 外觀：CAD 的網格，pose 由 tools/cad/sldasm_mesh.py 印出。推進器的外殼也放在 base_link
           （thruster_N link 會隨螺旋槳轉，不放 visual）。 -->
      <visual name="side_panel_left">
        <pose>-0.4 0.0468 0 1.5707963268 0 1.5707963268</pose>
        <geometry><mesh><uri>model://orca/meshes/side_panel.stl</uri></mesh></geometry>
        <material><diffuse>0.8 0.8 0.82 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="side_panel_right">
        <pose>0.4 -0.0468 0 1.5707963268 0 -1.5707963268</pose>
        <geometry><mesh><uri>model://orca/meshes/side_panel.stl</uri></mesh></geometry>
        <material><diffuse>0.8 0.8 0.82 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="tube">
        <pose>-0.1987 0 0.0064 1.5707963268 0 0</pose>
        <geometry><mesh><uri>model://orca/meshes/tube.stl</uri></mesh></geometry>
        <material><diffuse>0.75 0.85 0.95 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        <transparency>0.6</transparency>
      </visual>
      <visual name="ring_0">
        <pose>-0.1538 0 0.0064 1.5489 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/ring.stl</uri></mesh></geometry>
        <material><diffuse>0.65 0.65 0.7 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="ring_1">
        <pose>-0.1538 0 0.0064 -1.5927 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/ring.stl</uri></mesh></geometry>
        <material><diffuse>0.65 0.65 0.7 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="ring_2">
        <pose>0.151 0 0.0064 1.4763 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/ring.stl</uri></mesh></geometry>
        <material><diffuse>0.65 0.65 0.7 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="ring_3">
        <pose>0.151 0 0.0064 -1.6653 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/ring.stl</uri></mesh></geometry>
        <material><diffuse>0.65 0.65 0.7 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_0">
        <pose>0.055 0.1933 0.0053 0 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_1">
        <pose>0.055 -0.1933 0.0053 0 0 0</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_2">
        <pose>-0.055 0.1933 0.0053 0 0 3.1415926536</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_3">
        <pose>-0.055 -0.1933 0.0053 0 0 0</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_4">
        <pose>0.1927 0.1711 -0.0023 1.5707963268 0 0.7853981634</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_5">
        <pose>0.1927 -0.1711 -0.0023 1.5707963268 0 2.3561944902</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_6">
        <pose>-0.1927 0.1711 -0.0023 1.5707963268 0 -0.7853981634</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="t200_7">
        <pose>-0.1927 -0.1711 -0.0023 1.5707963268 0 -2.3561944902</pose>
        <geometry><mesh><uri>model://orca/meshes/t200.stl</uri></mesh></geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>

      <!-- ArduPilotPlugin 必需：JSON 封包的陀螺儀與加速度取自這顆 IMU。
           roll 180 度讓讀數是 ArduPilot 的機體座標 FRD。 -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000</water_density>
      <!-- 附加質量 -->
      <xDotU>-1</xDotU><yDotV>-1</yDotV><zDotW>-1</zDotW>
      <kDotP>-0.1</kDotP><mDotQ>-0.1</mDotQ><nDotR>-0.1</nDotR>
      <!-- 線性阻尼 -->
      <xU>-30</xU><yV>-30</yV><zW>-30</zW>
      <kP>-1</kP><mQ>-1</mQ><nR>-1</nR>
      <!-- 二次阻尼 -->
      <xUabsU>-1</xUabsU><yVabsV>-1</yVabsV><zWabsW>-1</zWabsW>
      <kPabsP>-1</kPabsP><mQabsQ>-1</mQabsQ><nRabsR>-1</nRabsR>
    </plugin>

    <link name="thruster_0">
      <pose relative_to="base_link">0.055 0.193 0.0163 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_0</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_0_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_1">
      <pose relative_to="base_link">0.055 -0.193 0.0163 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_1</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_1_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_2">
      <pose relative_to="base_link">-0.055 0.193 0.0163 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_2</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_2_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_3">
      <pose relative_to="base_link">-0.055 -0.193 0.0163 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_3</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_3_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_4">
      <pose relative_to="base_link">0.2005 0.1633 -0.002 0 0 -0.7853981634</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_4</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_4_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_5">
      <pose relative_to="base_link">0.2005 -0.1633 -0.002 0 0 0.7853981634</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_5</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_5_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_6">
      <pose relative_to="base_link">-0.2005 0.1633 -0.002 0 0 0.7853981634</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_6</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_6_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <link name="thruster_7">
      <pose relative_to="base_link">-0.2005 -0.1633 -0.002 0 0 -0.7853981634</pose>
      <inertial>
        <mass>0.427</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia>
      </inertial>
    </link>
    <joint name="thruster_7_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_7</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>thruster_7_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>1.0</thrust_coefficient>
    </plugin>
    <!--
      PWM → 推力：查 Blue Robotics 公開的 T200 靜態推力表（t200_bollard.csv，10～20 V），在 voltage 之間內插，
      正反轉取平均。T200 有死區（約 1472～1528 µs 推力為 0），小推力遠比線性小，例如 16 V 時
      PWM 1550／1600／1700／1900 → 1.3／5.3／16.0／45.7 N。原始碼與細節見 sim/plugins/thrust_curve/。
      voltage 是實機下水時的電池電壓；12～16 V 的曲線形狀幾乎一樣，只差一個倍數。
    -->
    <plugin filename="OrcaThrustCurve" name="orca::ThrustCurve">
      <table>model://orca/t200_bollard.csv</table>
      <voltage>16</voltage>
      <joint_name>thruster_0_joint</joint_name>
      <joint_name>thruster_1_joint</joint_name>
      <joint_name>thruster_2_joint</joint_name>
      <joint_name>thruster_3_joint</joint_name>
      <joint_name>thruster_4_joint</joint_name>
      <joint_name>thruster_5_joint</joint_name>
      <joint_name>thruster_6_joint</joint_name>
      <joint_name>thruster_7_joint</joint_name>
    </plugin>
    <!--
      ArduPilotPlugin：與 SITL 以 JSON over UDP 9002 交換狀態與 8 路 PWM，lockstep 同步。
      送到 cmd_pwm 的值 = multiplier * ((PWM - 1100) / 800 - 0.5)，|multiplier| = 800 → PWM - 1500 [µs]
      （範圍 ±400），由上面的 orca::ThrustCurve 換成推力。
      multiplier 的正負號 = MOT_n_DIRECTION * (推進器 joint 軸與 ArduSub 定義的推力方向同向 ? +1 : -1)：
      實機用 MOT_n_DIRECTION 補償螺旋槳正反轉與接線，模擬沒有這些差異，在這裡抵銷，
      使 PWM 的意義與實機相同。
    -->
    <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <!-- 外掛預設 no_time_sync = 1，SITL 收到會把 AHRS_EKF_TYPE 預設改成 10（直接用模擬真值、不跑 EKF）。
           關掉它，SITL 才跟實機一樣用 EKF3。 -->
      <no_time_sync>0</no_time_sync>
      <!-- 模型 FLU → ArduPilot 機體 FRD；Gazebo 世界 ENU → NED -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <!-- SERVO1 = ArduSub 馬達 1（水平、右前）→ 推進器 5 -->
      <control channel="0">
        <jointName>thruster_5_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_5_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>800</multiplier>
      </control>
      <!-- SERVO2 = ArduSub 馬達 2（水平、左前）→ 推進器 4 -->
      <control channel="1">
        <jointName>thruster_4_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_4_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>-800</multiplier>
      </control>
      <!-- SERVO3 = ArduSub 馬達 3（水平、右後）→ 推進器 7 -->
      <control channel="2">
        <jointName>thruster_7_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_7_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>-800</multiplier>
      </control>
      <!-- SERVO4 = ArduSub 馬達 4（水平、左後）→ 推進器 6 -->
      <control channel="3">
        <jointName>thruster_6_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_6_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>800</multiplier>
      </control>
      <!-- SERVO5 = ArduSub 馬達 5（垂直、右前）→ 推進器 1 -->
      <control channel="4">
        <jointName>thruster_1_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_1_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>800</multiplier>
      </control>
      <!-- SERVO6 = ArduSub 馬達 6（垂直、左前）→ 推進器 0 -->
      <control channel="5">
        <jointName>thruster_0_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_0_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>-800</multiplier>
      </control>
      <!-- SERVO7 = ArduSub 馬達 7（垂直、右後）→ 推進器 3 -->
      <control channel="6">
        <jointName>thruster_3_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_3_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>-800</multiplier>
      </control>
      <!-- SERVO8 = ArduSub 馬達 8（垂直、左後）→ 推進器 2 -->
      <control channel="7">
        <jointName>thruster_2_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/orca/joint/thruster_2_joint/cmd_pwm</cmd_topic>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <offset>-0.5</offset>
        <multiplier>800</multiplier>
      </control>
    </plugin>

  </model>
</sdf>
