<?xml version="1.0"?>
<!--
  Orca 加前視、底部兩顆相機，以及碰撞外框。model://orca 用 merge 原封不動併進來（推進器、
  ArduPilotPlugin、thruster topic 的 /model/orca/... 都不變），這裡只多相機、外框的 link 和固定 joint。
  有道具的世界檔 include 這個模型，名字一樣取 orca。

  相機：640x480、15 Hz、看到 60 m（泳池長 50 m，看得到另一頭的牆）。水平視角 55.7°（fx = 606 px），對齊實機 D435i 彩色 640x480 的
  camera_info（docs/laptop-rpi-relay.md 的實測）。位置在壓克力艙前端外面、艙的軸心上（x = 0.205 m），
  實機的安裝位置還沒量，之後量到再改 pose。
  Gazebo 的影像在 gz topic /orca/camera/image，由 sim/gz_camera_bridge.py 轉成 ROS。

  底部相機：640x480、10 Hz、水平視角 70°（實機的底部 USB 相機規格還沒定，之後換成實測值）。
  裝在壓克力艙底下的中線（z = −0.115 m）、船頭方向 0.1 m，朝正下方（實機位置還沒量）；影像上方 = 船頭、右方 = 右舷
  （src/orca_mission/config/orca.yaml 照這個方向）。gz topic /orca/bottom_camera/image。

  水下效果（越遠越暗、偏藍、模糊、噪點）不是在 Gazebo 裡算的（Harmonic 的 ogre2 不支援 fog）：
  每顆相機旁邊多一顆同位置、同視角的 depth camera（320x240，gz topic .../depth），
  sim/gz_camera_bridge.py 用深度圖對彩色影像做後處理（sim/underwater.py）。depth camera
  只有 bridge 訂閱時才算圖；它不會變成 ROS topic，ROS 這邊的影像 topic、frame_id、camera_info 都不變。
  彩色相機的 visibility_mask 設成 0x0FEFFFFF（267386879）：把 particle（flag 0x00100000）排除，
  看不到 model://water 裡給 Gazebo 視窗看的水體霧；depth camera 本來就不含 particle。

  碰撞外框（bumper_link）：model://orca 唯一的 collision 是 main_body_buoyancy（0.6 x 0.2 x 0.2 的
  浮力體），比實際的船窄很多（CAD 外框寬 48 cm），拿它判斷「有沒有碰到門」會太寬鬆。
  這裡照 CAD 的外形另外放一組 collision，並在上面掛 contact sensor：
  船碰到任何東西都會發到 gz topic /orca/contacts（gz.msgs.Contacts，含對方 collision 的名稱），
  sim/referee.py 讀它。
  **浮力**：Buoyancy 會對有 collision 的 link 算浮力，外框的體積不能算進去。所以用到這個模型的
  世界檔，Buoyancy 一定要寫 <enable>orca::base_link</enable>（只對 base_link 算，行為跟
  model://orca 完全一樣）。漏掉的話船會像氣球一樣彈出水面。
-->
<sdf version="1.9">
  <model name="orca">
    <include merge="true">
      <uri>model://orca</uri>
    </include>

    <link name="camera_link">
      <pose>0.205 0 0.0064 0 0 0</pose>
      <!-- 很輕，不影響船的浮力與平衡；沒有 collision，不參與浮力計算 -->
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.03 0.09 0.025</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- Gazebo 相機看 link 的 +x，影像的右邊是 link 的 -y（船的右舷） -->
      <sensor name="front_camera" type="camera">
        <pose>0.02 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/orca/camera/image</topic>
        <camera>
          <horizontal_fov>0.9725</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>60</far></clip>
          <visibility_mask>267386879</visibility_mask>
        </camera>
      </sensor>
      <!-- 水下效果用的深度（公尺，沿光軸），位置、視角同 front_camera -->
      <sensor name="front_depth" type="depth_camera">
        <pose>0.02 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/orca/camera/depth</topic>
        <camera>
          <horizontal_fov>0.9725</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.05</near><far>60</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="bottom_camera_link">
      <pose>0.1 0 -0.115 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.02</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- pitch +90°：相機的 +x（光軸）朝下，相機的上方 = 船頭 -->
      <sensor name="bottom_camera" type="camera">
        <pose>0 0 -0.012 0 1.5707963268 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/orca/bottom_camera/image</topic>
        <camera>
          <horizontal_fov>1.2217</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10</far></clip>
          <visibility_mask>267386879</visibility_mask>
        </camera>
      </sensor>
      <sensor name="bottom_depth" type="depth_camera">
        <pose>0 0 -0.012 0 1.5707963268 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/orca/bottom_camera/depth</topic>
        <camera>
          <horizontal_fov>1.2217</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.05</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- 碰撞外框：位置同 base_link，形狀照 model://orca 的 CAD 網格簡化：tube = 壓克力艙（半徑 11 cm、長 40.8 cm），
         side_panel_* = 兩側外殼的外框，thruster_N 對應八顆推進器（T200 外框：半徑 4.84 cm、長 11.27 cm）。 -->
    <link name="bumper_link">
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <collision name="tube">
        <pose>-0.0027 0 0.0064 0 1.5707963268 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.408</length></cylinder></geometry>
      </collision>
      <collision name="side_panel_left">
        <pose>0 0.1548 0 0 0 0</pose>
        <geometry><box><size>0.5 0.1359 0.2834</size></box></geometry>
      </collision>
      <collision name="side_panel_right">
        <pose>0 -0.1548 0 0 0 0</pose>
        <geometry><box><size>0.5 0.1359 0.2834</size></box></geometry>
      </collision>
      <collision name="thruster_0">
        <pose>0.055 0.193 0.0163 0 0 0</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_1">
        <pose>0.055 -0.193 0.0163 0 0 0</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_2">
        <pose>-0.055 0.193 0.0163 0 0 0</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_3">
        <pose>-0.055 -0.193 0.0163 0 0 0</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_4">
        <pose>0.2005 0.1633 -0.002 0 1.5707963268 -0.7853981634</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_5">
        <pose>0.2005 -0.1633 -0.002 0 1.5707963268 0.7853981634</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_6">
        <pose>-0.2005 0.1633 -0.002 0 1.5707963268 0.7853981634</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <collision name="thruster_7">
        <pose>-0.2005 -0.1633 -0.002 0 1.5707963268 -0.7853981634</pose>
        <geometry><cylinder><radius>0.0484</radius><length>0.1127</length></cylinder></geometry>
      </collision>
      <sensor name="contact" type="contact">
        <always_on>1</always_on>
        <contact>
          <collision>tube</collision>
          <collision>side_panel_left</collision>
          <collision>side_panel_right</collision>
          <collision>thruster_0</collision>
          <collision>thruster_1</collision>
          <collision>thruster_2</collision>
          <collision>thruster_3</collision>
          <collision>thruster_4</collision>
          <collision>thruster_5</collision>
          <collision>thruster_6</collision>
          <collision>thruster_7</collision>
          <topic>/orca/contacts</topic>
        </contact>
      </sensor>
    </link>

    <joint name="bumper_joint" type="fixed">
      <parent>base_link</parent>
      <child>bumper_link</child>
    </joint>
  </model>
</sdf>
