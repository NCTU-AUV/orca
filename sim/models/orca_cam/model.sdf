<?xml version="1.0"?>
<!--
  Orca 加一顆前視相機。model://orca 用 merge 原封不動併進來（推進器、ArduPilotPlugin、
  thruster topic 的 /model/orca/... 都不變），這裡只多一個相機 link 和固定 joint。
  有用到相機的世界檔改 include 這個模型，名字一樣取 orca。

  相機：640x480、15 Hz。水平視角 55.7°（fx = 606 px），對齊實機 D435i 彩色 640x480 的
  camera_info（docs/laptop-rpi-relay.md 的實測）。位置在船頭前緣中線，跟實機的安裝位置
  不一定相同，之後量到再改 pose。
  Gazebo 的影像在 gz topic /orca/camera/image，由 sim/gz_camera_bridge.py 轉成 ROS。
  水下的光線衰減、色偏沒有模擬（Harmonic 的 ogre2 不支援 fog），畫面比實際清楚。
-->
<sdf version="1.9">
  <model name="orca">
    <include merge="true">
      <uri>model://orca</uri>
    </include>

    <link name="camera_link">
      <pose>0.32 0 0 0 0 0</pose>
      <!-- 很輕，不影響船的浮力與平衡；沒有 collision，不參與浮力計算 -->
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.03 0.09 0.025</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- Gazebo 相機看 link 的 +x，影像的右邊是 link 的 -y（船的右舷） -->
      <sensor name="front_camera" type="camera">
        <pose>0.02 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/orca/camera/image</topic>
        <camera>
          <horizontal_fov>0.9725</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
