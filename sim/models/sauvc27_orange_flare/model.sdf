<?xml version="1.0"?>
<!--
橘色 flare（規則書 §9.1、Figure 12）：約 150 cm 高、約 15 cm 寬，立在池底。
  碰到就立刻中止這次 attempt。比賽照片上是綁在配重上的充氣標示浮標（扁的），
  外形沿用 2026 模擬（SAUVC-Simulation 的 orange_flare）。static：不會被撞歪。原點在池底。

  由 sim/arena/sauvc2027.py 產生，不要手改。
-->
<sdf version="1.9">
  <model name="sauvc27_orange_flare">
    <static>true</static>
    <link name="flare"><visual name="weight"><pose>0 0 0.02 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.04</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="weight_col"><pose>0 0 0.02 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.04</length></cylinder></geometry></collision><visual name="blade"><pose>0 0 0.79 0 0 0</pose><geometry><box><size>0.15 0.07 1.5</size></box></geometry><material><ambient>0.4 0.104 0.02 1</ambient><diffuse>1 0.26 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="blade_col"><pose>0 0 0.79 0 0 0</pose><geometry><box><size>0.15 0.07 1.5</size></box></geometry></collision><visual name="cuff"><pose>0 0 0.09 0 0 0</pose><geometry><box><size>0.15 0.075 0.1</size></box></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link>
  </model>
</sdf>
