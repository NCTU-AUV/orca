<?xml version="1.0"?>
<!--
  由 tools/sim/gen_assets.py 產生，不要手改：改那支再重跑

  導航門，SAUVC 2027 Rulebook 2027.3.2：寬 150 cm、高 150 cm，立在池底；
  port 柱（-x）紅黑條紋、starboard 柱（+x）綠黑條紋，柱徑 4 cm。（2026 是高 100 cm。）
  條紋「色 ~20 cm、黑 ~10 cm」取自 docs/sim/reference/gate-2024.jpg。黑色橫桿與白色 PVC 地面框
  來自實拍（gate-2022.jpg、gate+flare-2022.jpg）；地面框沒有 collision（貼著池底，碰到它等於碰池底）。

  模型原點在池底、兩柱中間；兩柱沿模型 x，船沿模型 y 穿過。static：撞到會被擋住。
  規則：碰到門扣 2 分（sim/referee.py）。
-->
<sdf version="1.9">
  <model name="gate">
    <static>true</static>

    <link name="port_post">
      <pose>-0.75 0 0 0 0 0</pose>
      <visual name="shoe"><pose>0 0 0.0250 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.0500</length></cylinder></geometry><material><ambient>0.94 0.95 0.96 1</ambient><diffuse>0.94 0.95 0.96 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
