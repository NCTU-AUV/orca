<!--
SAUVC 2027 泳池：50 m × 25 m 奧運池（規則書 §8 Figure 5 側視圖）。
  淺端水深 1.28 m、平台長 1.8 m，斜坡水平長 17.5 m，之後深區水深 2.0 m。
  原點在淺端、出發區那一側的池角水面；x 沿長邊，y 沿短邊。池壁高出水面 0.4 m。
  地板分三段，各段的貼圖由 sim/arena/make_pool_textures.py 產生（水道線在真實位置）。

  由 sim/arena/sauvc2027.py 產生，不要手改。
-->
<sdf version="1.9">
  <model name="sauvc27_pool">
    <static>true</static>
    <link name="floor_shallow"><pose>0.9 12.5 -1.28 0 0 0</pose><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>1.8 25</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.08 0.08 0.08 1</specular><pbr><metal><albedo_map>model://sauvc27_pool/materials/textures/floor_shallow.png</albedo_map><metalness>0</metalness><roughness>0.55</roughness></metal></pbr></material></visual><collision name="collision"><pose>0 0 -0.1 0 0 0</pose><geometry><box><size>1.8 25 0.2</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision></link><link name="floor_slope"><pose>10.55 12.5 -1.64 0 0.0411 0</pose><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>17.5148 25</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.08 0.08 0.08 1</specular><pbr><metal><albedo_map>model://sauvc27_pool/materials/textures/floor_slope.png</albedo_map><metalness>0</metalness><roughness>0.55</roughness></metal></pbr></material></visual><collision name="collision"><pose>0 0 -0.1 0 0 0</pose><geometry><box><size>17.5148 25 0.2</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision></link><link name="floor_deep"><pose>34.65 12.5 -2 0 0 0</pose><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30.7 25</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.08 0.08 0.08 1</specular><pbr><metal><albedo_map>model://sauvc27_pool/materials/textures/floor_deep.png</albedo_map><metalness>0</metalness><roughness>0.55</roughness></metal></pbr></material></visual><collision name="collision"><pose>0 0 -0.1 0 0 0</pose><geometry><box><size>30.7 25 0.2</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision></link><link name="wall_shallow"><pose>-0.15 12.5 -0.85 0 0 0</pose><visual name="visual"><geometry><box><size>0.3 25 2.5</size></box></geometry><