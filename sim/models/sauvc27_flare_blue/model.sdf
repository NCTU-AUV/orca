<?xml version="1.0"?>
<!--
blue flare（規則書 §9.4、Figure 17）：80 cm 高、直徑約 1.6 cm，頂上放一顆高爾夫球。
  撞到（或靠近）讓球掉下來就得分。flare 本體與球都是動態的：
    - 本體 1.5 kg、重心壓低在底座，被撞會晃、會倒；
    - 球是獨立的 link（沒有 joint），放在杆頂的小托座上，晃動夠大就會滾落。
  桿子用規則書的 1.6 cm（2026 模擬為了偵測把視覺放大 5 倍，這裡沒有）。原點在池底。

  由 sim/arena/sauvc2027.py 產生，不要手改。
-->
<sdf version="1.9">
  <model name="sauvc27_flare_blue">
    <static>false</static>
    <self_collide>true</self_collide>
    <link name="flare"><inertial><pose>0 0 0.04 0 0 0</pose><mass>1.5</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.004</izz></inertia></inertial><visual name="foot"><pose>0 0 0.015 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.03</length></cylinder></geometry><material><ambient>0.06 0.14 0.34 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="foot_col"><pose>0 0 0.015 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.03</length></cylinder></geometry></collision><visual name="pole"><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.8</length></cylinder></geometry><material><ambient>0.06 0.14 0.34 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="pole_col"><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.8</length></cylinder></geometry></collision><visual name="cup"><pose>0 0 0.803 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.006</length></cylinder></geometry><material><ambient>0.06 0.14 0.34 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="cup_col"><pose>0 0 0.803 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.006</length></cylinder></geometry></collision><visual name="cup_lip_0"><pose>0.0145 0 0.81 0 0 0</pose><geometry><box><size>0.006 0.006 0.008</size></box></geometry><material><ambient>0.06 0.14 0.34 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="cup_lip_0_col"><pose>0.0145 0 0.81 0 0 0</pose><geometry><box><size>0.006 0.006 0.008</size></box></geometry></collision><visual name="cup_lip_1"><pose>0.0103 0.0103 0.81 0 0 0.7854</pose><geometry><box><size>0.006 0.006 0.008</size></box></geometry><material><ambient>0.06 0.14 0.