<?xml version="1.0"?>
<!--
資格賽門（規則書 §8.1、Figure 8）：150 cm 寬、約 100 cm 深，從水面垂下，
  左右兩柱 4 cm 寬、橘色，頂上是浮在水面的白色浮桿。碰到任何一邊就算失敗。
  原點在水面、兩柱中間；柱子在模型 x 方向，從模型 ±y 方向穿過。

  由 sim/arena/sauvc2027.py 產生，不要手改。
-->
<sdf version="1.9">
  <model name="sauvc27_qual_gate">
    <static>true</static>
    <link name="gate"><visual name="float_bar"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.54 0.1 0.06</size></box></geometry><material><ambient>0.376 0.38 0.384 1</ambient><diffuse>0.94 0.95 0.96 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="float_bar_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.54 0.1 0.06</size></box></geometry></collision><visual name="port_post"><pose>-0.75 0 -0.5 0 0 0</pose><geometry><box><size>0.04 0.04 1</size></box></geometry><material><ambient>0.4 0.18 0.02 1</ambient><diffuse>1 0.45 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="port_post_col"><pose>-0.75 0 -0.5 0 0 0</pose><geometry><box><size>0.04 0.04 1</size></box></geometry></collision><visual name="starboard_post"><pose>0.75 0 -0.5 0 0 0</pose><geometry><box><size>0.04 0.04 1</size></box></geometry><material><ambient>0.4 0.18 0.02 1</ambient><diffuse>1 0.45 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="starboard_post_col"><pose>0.75 0 -0.5 0 0 0</pose><geometry><box><size>0.04 0.04 1</size></box></geometry></collision></link>
  </model>
</sdf>
