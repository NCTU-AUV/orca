<?xml version="1.0"?>
<!--
  資格賽門：orca_pool.sdf 加上相機（model://orca_cam）與資格賽門（model://q_gate）。
  門從水面垂到池底，任何深度都能過；門在船頭前方 6 m、偏右 1 m，讓對準那一步有事可做。
  用法：WORLD=orca_qgate.sdf（deploy/sim/gate_pass.sh 預設用這個）
-->
<sdf version="1.9">
  <world name="orca_qgate">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 相機的算圖。ogre2；沒開 GUI 時 start.sh 會加 headless rendering -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 更新模型裡的 IMU 感測器（ArduPilotPlugin 讀它） -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 水的浮力：z < 0 為 1000 kg/m^3，z > 0 為空氣 -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.88 0.92 1</background>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.15 0.08 -0.98</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <include>
      <uri>model://pool</uri>
    </include>

    <!-- Orca + 前視相機（model://orca_cam：model://orca 原封不動併入，多一顆相機） -->
    <include>
      <uri>model://orca_cam</uri>
      <pose>0 0 -0.2 0 0 0</pose>
    </include>

    <!-- 資格賽門：原點在水面、兩根柱子在模型 x 方向；轉 90° 讓門面朝 +x（船頭方向） -->
    <include>
      <uri>model://q_gate</uri>
      <name>q_gate</name>
      <pose>6 -1 0 0 0 1.5707963268</pose>
    </include>

  </world>
</sdf>
