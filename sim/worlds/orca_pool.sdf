<?xml version="1.0"?>
<!--
  Orca 在 SAUVC 泳池。水面在 z = 0，z > 0 為空氣。
  改寫自 https://github.com/NCTU-AUV/SAUVC-Simulation 的 water_world.sdf（Fortress → Harmonic）。
  比賽道具、相機等之後用另一個世界檔 <include> 加入，不改這份。
-->
<sdf version="1.9">
  <world name="orca_pool">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 更新模型裡的 IMU 感測器（ArduPilotPlugin 讀它） -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 水的浮力：z < 0 為 1000 kg/m^3，z > 0 為空氣 -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.88 0.92 1</background>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.15 0.08 -0.98</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <include>
      <uri>model://pool</uri>
    </include>

    <include>
      <uri>model://orca</uri>
      <pose>0 0 -0.2 0 0 0</pose>
    </include>
  </world>
</sdf>
