<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orca_session</name>
  <version>0.1.0</version>
  <description>Session logging helpers: current session, log directories, markers, FC parameter snapshot, bag slicing</description>
  <maintainer email="tsaicky@users.noreply.github.com">NCTU-AUV</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
